        {
          "id": "vnozgfplb3zozel1a656m9jd",
          "hidden": false,
          "company": "ValueLabs",
          "position": "Senior Engineer - QE",
          "location": "Remote",
          "period": "Jun 2023 – Present",
          "dates": {
            "start": "2023-06",
            "end": null,
            "present": true
          },
          "website": {
            "url": "",
            "label": "",
            "inlineLink": false
          },
          "description": "<ul><li><p data-resume-whitespace=\"preserve\"><strong>Automation Practices &amp; Code Review:</strong> Drove automation best practices and processes for a 10+ member QA team: mentored engineers, defined automation coding standards, and reviewed 95% of pull requests across project repositories; authored 500+ commits across multiple API and UI automation projects.</p></li><li><p data-resume-whitespace=\"preserve\"><strong>Mosaic Automation Framework:</strong> Architected the Mosaic UI and API automation framework (Java, REST Assured, Selenium with Page Object Model, Cucumber BDD) for a portfolio of 6+ airline programs; 1,500+ tests cut regression effort from 1,125 to 125 man-hours (90%). Containerized suites with Docker and ran daily/weekly smoke and regression in Harness CI/CD (previously TeamCity).</p></li><li><p data-resume-whitespace=\"preserve\"><strong>AI Defect Automation:</strong> Built an AI-driven Azure DevOps defect pipeline in the REST Assured framework that auto-files bugs when failure-to-user-story confidence exceeds 95%, cutting initial triage and bug-filing effort by 70%.</p></li><li><p data-resume-whitespace=\"preserve\"><strong>AI Quality Insights:</strong> Developed an AI-driven EQE best-practices tracker (Python, Microsoft Teams webhooks, GitHub AI API, Ollama) giving sprint-level compliance insights across projects and removing 80% of manual monitoring.</p></li><li><p data-resume-whitespace=\"preserve\"><strong>Log Monitoring:</strong> Automated daily error-log analysis across 30+ microservices using Kibana, Dynatrace and Kafka event logs, catching 2–4 critical defects before each release.</p></li><li><p data-resume-whitespace=\"preserve\"><strong>AI Initiatives:</strong> Designed Copilot-based AI agents automating STLC workflows with Azure DevOps and Maven, reducing delivery time by 60%.</p></li></ul>",
          "roles": []
        },
